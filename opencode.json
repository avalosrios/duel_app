{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "default_agent": "build",
  "permission": {
    "edit": "allow",
    "read": "allow",
    "bash": "ask",
    "webfetch": "allow"
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "anthropic/claude-sonnet-4-6",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "plan": {
      "mode": "primary",
      "model": "github-copilot/claude-haiku-4.5",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    }
  },
  "provider": {
    "copilot": {
      "models": {
        "github-copilot/claude-haiku-4.5": {
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "verbose",
            "reasoningSummary": "auto"
          },
          "limit": {
            "context": 30000,
            "output": 100000
          }
        }
      }
    },
    "anthropic": {
      "models": {
        "anthropic/claude-sonnet-4-6": {
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 30000
            }
          }
        }
      }
    }
  }
}